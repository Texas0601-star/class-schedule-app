{
  "name": "class-schedule-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "我的课表 —— Capacitor 打包的 Android 应用外壳（网页源码在 ../class-schedule）",
  "scripts": {
    "sync:web": "node sync-web.mjs",
    "sync": "npm run sync:web && cap sync android",
    "add:android": "cap add android",
    "open:android": "cap open android",
    "build:apk": "npm run sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
